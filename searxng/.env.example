# Copy to .env (chmod 600). Never commit .env.
SEARXNG_HOSTNAME=search.example.com
TUNNEL_ID=00000000-0000-0000-0000-000000000000
TUNNEL_CREDENTIALS=/home/you/.cloudflared/00000000-0000-0000-0000-000000000000.json
# Your user's uid:gid (run `id -u`:`id -g`), so the container can read TUNNEL_CREDENTIALS
UID_GID=1000:1000
# Generate each with: openssl rand -hex 32
SEARXNG_KEY=
SEARXNG_SECRET=
# Hard limit for all searches together (nginx syntax, e.g. 30r/m)
SEARXNG_RATE=30r/m
